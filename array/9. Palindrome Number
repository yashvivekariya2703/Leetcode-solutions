class Solution {
public:
    bool isPalindrome(int x) {
        if (x < 0) {
            return false;
        }

        int num = x;
        vector<int> arr;

        while (num != 0) {
            int digit = num % 10;
            arr.push_back(digit);
            num = num / 10;
        }

        for (int i = 0; i < arr.size() / 2; i++) {
            int j = arr.size() - 1 - i;

            if (arr[i] != arr[j]) {
                return false;
            }
        }

        return true;
    }
};